<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares a narrowly scoped accessibility service used only to detect when
  Google Maps is in the foreground so we can offer a one-tap Park/Cafe save UI.
  We do not read passwords, text content, or control other apps.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="200"
    android:packageNames="com.google.android.apps.maps"
    android:settingsActivity="com.parksandcafe.app.MainActivity" />
