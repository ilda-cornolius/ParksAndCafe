<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="6dp"
    android:background="@drawable/widget_shell"
    android:weightSum="2">

    <LinearLayout
        android:id="@+id/btn_park"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="4dp"
        android:background="@drawable/btn_park"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/btn_park"
            android:src="@drawable/ic_park"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_park"
            android:textColor="@color/on_brand"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_cafe"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:background="@drawable/btn_cafe"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/btn_cafe"
            android:src="@drawable/ic_cafe"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_cafe"
            android:textColor="@color/on_brand"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.02" />
    </LinearLayout>
</LinearLayout>
